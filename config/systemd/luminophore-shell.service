[Unit]
Description=Luminophore corner widget shell
PartOf=luminophore-session.target
StartLimitIntervalSec=30
StartLimitBurst=5
OnFailure=luminophore-shell-failure.service

ConditionPathExists=%t/luminophore/session.env

[Service]
EnvironmentFile=%t/luminophore/session.env
ExecCondition=/usr/bin/luminophore-session check
Type=simple
Environment=GSK_RENDERER=vulkan
Environment=LUMINOPHORE_SHELL_BLOOM=1
ExecStart=/usr/bin/luminophore-session component shell
KillMode=control-group
Restart=on-failure
RestartSec=1
TimeoutStopSec=3

[Install]
WantedBy=luminophore-session.target
