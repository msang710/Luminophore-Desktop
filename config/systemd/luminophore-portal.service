[Unit]
Description=Luminophore desktop portal
PartOf=luminophore-session.target
ConditionPathExists=%t/luminophore/session.env

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.luminophore
EnvironmentFile=%t/luminophore/session.env
ExecCondition=/usr/bin/luminophore-session check
ExecStart=/usr/bin/luminophore-session component portal
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=luminophore-session.target
