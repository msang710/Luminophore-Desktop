#!/usr/bin/env python3
"""Check source branding; immutable provenance and migration adapters are exceptions."""
from pathlib import Path
import json
import re
import sys

root = Path(__file__).resolve().parents[2]
pattern = re.compile('neon', re.I)
excluded = {'.git', 'subprojects', 'artifacts', '.work', '__pycache__', 'profile-runtime', 'build'}
allowed = {
    'config/luminophore_shell/brand_migration.py',
    'config/tests/test_brand_migration.py',
    'config/scripts/check-brand-names',
    'compositor/src/version.h', # generated historical Git commit message
    'config/luminophore_shell/assets/cursors/bibata-modern-ice-source/PROVENANCE.md',
}
failures = []
for name in ('config', 'compositor', 'Luminophore-OS'):
    import os
    for current, dirs, files in os.walk(root / name, followlinks=False):
        dirs[:] = [d for d in dirs if d not in excluded and not (Path(current)/d).is_symlink()]
        for leaf in dirs + files:
            p = Path(current) / leaf
            relative = str(p.relative_to(root))
            if relative in allowed or relative.startswith('Luminophore-OS/packaging/manifests/') or p.is_symlink():
                continue
            if pattern.search(leaf):
                failures.append({'path':relative,'kind':'filename'})
            if not p.is_file() or p.name == '.git':
                continue
            data = p.read_bytes()
            if b'\0' in data:
                continue
            try:
                text = data.decode('utf-8')
            except UnicodeError:
                continue
            for index, line in enumerate(text.splitlines(), 1):
                if pattern.search(line):
                    failures.append({'path':relative,'kind':'content','line':index})
print(json.dumps({'ok':not failures,'residuals':failures}, indent=2))
raise SystemExit(bool(failures))
