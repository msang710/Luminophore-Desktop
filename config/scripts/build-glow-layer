#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
build_root=$(mktemp -d)
trap 'rm -rf -- "$build_root"' EXIT INT TERM
protocol="$project_root/native/protocols/wlr-layer-shell-unstable-v1.xml"
xdg_protocol=/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml
wayland-scanner client-header "$protocol" "$build_root/wlr-layer-shell-unstable-v1-client-protocol.h"
wayland-scanner private-code "$protocol" "$build_root/wlr-layer-shell-unstable-v1-protocol.c"
wayland-scanner client-header "$xdg_protocol" "$build_root/xdg-shell-client-protocol.h"
wayland-scanner private-code "$xdg_protocol" "$build_root/xdg-shell-protocol.c"
cc -O2 -Wall -Wextra -Werror -I"$build_root" \
    $(pkg-config --cflags wayland-client wayland-egl egl glesv2 libpipewire-0.3) \
    "$project_root/native/luminophore_glow_layer.c" \
    "$project_root/native/luminophore_audio_capture.c" \
    "$project_root/native/luminophore_spectrum.c" \
    "$build_root/wlr-layer-shell-unstable-v1-protocol.c" \
    "$build_root/xdg-shell-protocol.c" \
    -o "$project_root/luminophore_shell/luminophore-glow-layer" \
    $(pkg-config --libs wayland-client wayland-egl egl glesv2 libpipewire-0.3) -lm
printf '%s\n' "$project_root/luminophore_shell/luminophore-glow-layer"
