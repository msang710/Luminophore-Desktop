#!/usr/bin/env python3
"""CPU-only independent-board preview benchmark; does not measure frame pacing."""
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parents[2]
source = root / "src/luminophore"
files = ["LuminophoreSpatialModel", "LuminophoreSpatialIndependent", "LuminophoreSpatialBoard", "LuminophoreSpatialPlacementPolicy",
         "LuminophoreSpatialFill", "LuminophoreSpatialMesh", "LuminophoreSpatialResize", "LuminophoreSpatialProjection",
         "LuminophoreSpatialBoardProjection", "LuminophoreSpatialCommitter", "LuminophoreOutputViewSolver"]
with tempfile.TemporaryDirectory(prefix="luminophore-board-benchmark-") as directory:
    binary = Path(directory) / "benchmark"
    subprocess.run(["c++", "-std=c++23", "-O2", "-I", str(source),
                    str(root / "luminophore/benchmarks/spatial_boards.cpp"),
                    *(str(source / (name + ".cpp")) for name in files), "-lhyprutils", "-o", str(binary)], check=True)
    subprocess.run([str(binary)], check=True)
