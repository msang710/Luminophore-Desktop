#!/usr/bin/env python3
"""Compile pure model CPU fixtures. --baseline accepts a pre-change luminophore source copy."""
import argparse
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument('--baseline', type=Path)
args = parser.parse_args()
root = Path(__file__).resolve().parents[2]
source = args.baseline or root / 'src/luminophore'
files = ['LuminophoreSpatialModel.cpp', 'LuminophoreSpatialProjection.cpp', 'LuminophoreSpatialCommitter.cpp', 'LuminophoreOutputViewSolver.cpp']
flags = []
if args.baseline is None:
    flags.append('-DLUMINOPHORE_PREVIEW_CACHE')
    files.extend(['LuminophoreSpatialPreview.cpp', 'LuminophoreSpatialIndependent.cpp', 'LuminophoreSpatialBoard.cpp', 'LuminophoreSpatialPlacementPolicy.cpp', 'LuminophoreSpatialFill.cpp', 'LuminophoreSpatialMesh.cpp', 'LuminophoreSpatialResize.cpp', 'LuminophoreSpatialBoardProjection.cpp'])
with tempfile.TemporaryDirectory(prefix='luminophore-preview-bench-') as directory:
    binary = Path(directory) / 'benchmark'
    subprocess.run(['c++', '-std=c++23', '-O2', *flags, '-I', str(source),
                    str(root / 'luminophore/benchmarks/spatial_preview.cpp'),
                    *(str(source / name) for name in files), '-lhyprutils', '-o', str(binary)], check=True)
    subprocess.run([str(binary)], check=True)
